* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Segoe UI', Arial, sans-serif;
    background-color: #f0f4f8;
    color: #222831;
    line-height: 1.6;
}

/* Шапка */
.header {
    background-color: #1a3d5c;
    color: #ffffff;
    padding: 40px 20px;
    text-align: center;
}

.header h1 {
    font-size: 2.6rem;
    letter-spacing: 2px;
    margin-bottom: 10px;
}

.subtitle {
    font-size: 1.1rem;
    color: #cfe3f5;
    font-style: italic;
}

/* Контейнер */
.container {
    max-width: 900px;
    margin: 40px auto;
    padding: 0 20px;
    display: flex;
    flex-direction: column;
    gap: 40px;
}

/* Карточка персонажа */
.card {
    background-color: #ffffff;
    border-radius: 12px;
    padding: 25px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
    display: flex;
    flex-wrap: wrap;
    gap: 25px;
    align-items: flex-start;
}

.photo {
    width: 220px;
    height: 220px;
    object-fit: cover;
    border-radius: 12px;
    border: 4px solid #1a3d5c;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
}

.info {
    flex: 1;
    min-width: 260px;
}

.info h2 {
    color: #1a3d5c;
    margin: 15px 0 10px;
    font-size: 1.4rem;
    border-bottom: 2px solid #d0e1f1;
    padding-bottom: 5px;
}

.info ul {
    margin: 10px 0 10px 25px;
}

.info li {
    margin-bottom: 6px;
}

.info a {
    color: #1e88e5;
    text-decoration: none;
}

.info a:hover {
    text-decoration: underline;
}

/* Форма обратной связи */
.feedback {
    background-color: #ffffff;
    border-radius: 12px;
    padding: 25px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
}

.feedback h2 {
    color: #1a3d5c;
    margin-bottom: 20px;
    font-size: 1.5rem;
}

.form-group {
    margin-bottom: 18px;
}

.form-group label {
    display: block;
    margin-bottom: 6px;
    font-weight: 600;
    color: #1a3d5c;
}

.form-group input,
.form-group textarea {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid #b8c7d6;
    border-radius: 8px;
    font-size: 1rem;
    font-family: inherit;
    background-color: #f9fbfd;
    transition: border-color 0.2s, box-shadow 0.2s;
}

.form-group input:focus,
.form-group textarea:focus {
    outline: none;
    border-color: #1e88e5;
    box-shadow: 0 0 0 3px rgba(30, 136, 229, 0.2);
}

/* Кнопка */
.btn {
    background-color: #1e88e5;
    color: #ffffff;
    border: none;
    padding: 12px 28px;
    font-size: 1rem;
    font-weight: 600;
    border-radius: 8px;
    cursor: pointer;
    transition: background-color 0.2s, transform 0.1s;
}

.btn:hover {
    background-color: #1565c0;
}

.btn:active {
    transform: scale(0.97);
}

/* Сообщение об ошибке */
.error-box {
    color: #c62828;
    background-color: #fdecea;
    border: 1px solid #f5c2c0;
    border-radius: 8px;
    padding: 0;
    margin-bottom: 15px;
    font-size: 0.95rem;
    max-height: 0;
    overflow: hidden;
    transition: all 0.25s ease;
}

.error-box.visible {
    padding: 10px 14px;
    max-height: 300px;
    margin-bottom: 15px;
}

.error-box ul {
    margin-left: 18px;
}

/* Подвал */
.footer {
    text-align: center;
    padding: 25px 15px;
    color: #5a6b7c;
    font-size: 0.9rem;
    border-top: 1px solid #d8e2ec;
    margin-top: 20px;
}

/* Небольшая адаптивность для мобильных */
@media (max-width: 600px) {
    .card {
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .info ul {
        text-align: left;
    }

    .header h1 {
        font-size: 2rem;
    }
}
